<Window x:Class="AplikacjaOkienkowa.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AplikacjaOkienkowa"
        mc:Ignorable="d"
        Title="Katalog okienkowy" Height="600" Width="800">
    <StackPanel x:Name="GlownyPanel"
                Margin="20">
        <TextBlock Text="Katalog produktów"
                   FontSize="24"
                   FontWeight="Bold"    />
        <TextBlock x:Name="EtykietaLiczbaProduktow"
                   Text="Produktów: 0"
                   FontSize="14"
                   Margin="0, 10, 0, 0"  />
        <TextBlock x:Name="EtykietaWartoscMagazynu"
                   Text="Wartość magazynu: 0"
                   FontSize="14"
                   Margin="0, 10, 0, 0"  />
        <!-- W środku buttona można umieścić textblock -->
        <Button Margin="0, 10, 0, 0" HorizontalAlignment="Center" Padding="5">
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Images/add.png" 
                       Width="20"
                       Height="20"  />
                <TextBlock Text="Dodaj produkt"
                           FontSize="14"
                           FontWeight="Bold" />
            </StackPanel>
        </Button>
        <!-- wewnątrz StackPanel możemy umieszczyć dowolne elementy, np. TextBox, ComboBox, ListBox itp., ale też całego grida -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Grid.Row="0" Content="Button 1"/>
            <Button Grid.Column="0" Grid.Row="1" Content="Button 2"/>
            <Button Grid.Column="1" Grid.Row="0" Content="Button 3"/>
            <Button Grid.Column="1" Grid.Row="1" Content="Button 4"/>
        </Grid>
    </StackPanel>
</Window>
