<Window x:Class="AplikacjaOkienkowa.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AplikacjaOkienkowa"
        mc:Ignorable="d"
        Title="Katalog okienkowy" Height="600" Width="800">
    <StackPanel Margin="20">
        <TextBlock Text="Katalog produktów"
                   FontSize="24"
                   FontWeight="Bold"    />
        <TextBlock x:Name="EtykietaLiczbaProduktow"
                   Text="Produktów: 0"
                   FontSize="14"
                   Margin="0, 10, 0, 0"  />
        <TextBlock x:Name="EtykietaWartoscMagazynu"
           Text="Wartość magazynu: 0"
           FontSize="14"
           Margin="0, 10, 0, 0"  />
    </StackPanel>
</Window>
